BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
S3_BUCKET_NAME=your-s3-bucket-name

# Optional: enables the "Create GitHub Task" mode in the UI.
# When GITHUB_TOKEN is set, the app offers a mode that skips requirements/design/tasks
# generation and instead creates a GitHub issue directly from the transcript.
# GITHUB_TOKEN needs "repo" scope (classic PAT) or "Issues: Read & Write" (fine-grained PAT).
GITHUB_TOKEN=
# Format: owner/repo, e.g. my-org/my-repo
GITHUB_REPO=
